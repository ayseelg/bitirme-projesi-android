<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3F9">

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Geri Butonu -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#0D47A1"
                android:contentDescription="Geri" />

            <!-- Ana Başlık -->
            <TextView
                android:id="@+id/tvMainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Beton Hasar Bilgilendirme"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#0D47A1"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deprem sonrası hızlı ön değerlendirme amaçlıdır"
                android:textSize="14sp"
                android:textColor="#546E7A"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <!-- ANA KART -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Nedir -->
                    <TextView
                        android:text="Bu Uygulama Ne Yapar?"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Uygulama, yapı yüzey fotoğraflarında deprem kaynaklı bozulma işaretlerini tespit etmeye yardımcı olur. Model sonucu ön inceleme niteliğindedir."
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Türler -->
                    <TextView
                        android:text="Tespit Edilen Sınıflar"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="• Crack: Yüzeyde çatlak oluşumu\n• Efflorescence: Yüzeyde beyaz tuz kusması\n• Exposed Rebar: Donatının açığa çıkması\n• Spalling: Beton örtüsünün dökülmesi"
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Belirtiler -->
                    <TextView
                        android:text="Sahada Dikkat Edilecek Bulgular"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="• Eğik/uzun süreklilik gösteren çatlaklar\n• Kolon-kiriş birleşimlerinde ayrılma\n• Donatı pası ve açık demir görünümü\n• Beton parça kopmaları"
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Tanı -->
                    <TextView
                        android:text="Modelin Kullanım Akışı"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Fotoğraf yüklenir, model seçilir (YOLOv8/11/12), ardından sistem hasar sınıfı ve güven skoru üretir."
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Tedavi -->
                    <TextView
                        android:text="Sonraki Teknik Adımlar"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Model sonucu yüksek risk gösteriyorsa yerinde uzman incelemesi, detaylı hasar tespiti ve güçlendirme/onarım planlaması yapılmalıdır."
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Uyarı -->
                    <TextView
                        android:text="Önemli Uyarı"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Bu uygulama resmi deprem performans analizi yerine geçmez. Sonuçlar yalnızca ön değerlendirme içindir; nihai karar yetkili uzman incelemesi ile verilmelidir."
                        android:textSize="14sp"
                        android:textColor="#455A64"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
