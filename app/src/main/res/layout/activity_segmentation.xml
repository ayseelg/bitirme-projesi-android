<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3F9">

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Geri Butonu -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#0D47A1"
                android:contentDescription="Geri" />

            <!-- Ana Başlık -->
            <TextView
                android:id="@+id/tvMainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Beyin Tümörü Bilgilendirme"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#0D47A1"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tıbbi bilgilendirme amaçlıdır"
                android:textSize="14sp"
                android:textColor="#546E7A"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <!-- ANA KART -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Nedir -->
                    <TextView
                        android:text="Beyin Tümörü Nedir?"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Beyin tümörü, beyinde veya beyni çevreleyen dokularda hücrelerin kontrolsüz çoğalması sonucu oluşan kitlelerdir. İyi huylu (benign) veya kötü huylu (malign) olabilir."
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Türler -->
                    <TextView
                        android:text="Tümör Türleri"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="• İyi huylu tümörler: Yavaş büyür, çevre dokulara yayılmaz.\n• Kötü huylu tümörler: Hızlı büyüyebilir ve beyin fonksiyonlarını ciddi şekilde etkileyebilir."
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Belirtiler -->
                    <TextView
                        android:text="Olası Belirtiler"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="• Şiddetli baş ağrıları\n• Görme ve konuşma bozuklukları\n• Denge kaybı\n• Hafıza sorunları\n• Nöbet (epilepsi)"
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Tanı -->
                    <TextView
                        android:text="Tanı Yöntemleri"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Beyin tümörleri genellikle MR (Manyetik Rezonans), BT (Bilgisayarlı Tomografi) ve biyopsi gibi yöntemlerle teşhis edilir."
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Tedavi -->
                    <TextView
                        android:text="Tedavi Seçenekleri"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Tedavi; tümörün türüne, konumuna ve hastanın durumuna göre cerrahi, radyoterapi ve kemoterapiyi içerebilir."
                        android:textSize="15sp"
                        android:textColor="#37474F"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginVertical="16dp"/>

                    <!-- Uyarı -->
                    <TextView
                        android:text="Önemli Uyarı"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Bu uygulamada sunulan bilgiler tanı amacı taşımaz. Kesin teşhis ve tedavi için mutlaka bir sağlık uzmanına başvurulmalıdır."
                        android:textSize="14sp"
                        android:textColor="#455A64"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
